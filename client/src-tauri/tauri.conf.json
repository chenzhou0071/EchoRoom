{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Echo",
  "version": "0.3.0",
  "identifier": "com.echoroom.dev",
  "build": { "frontendDist": "../ui" },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Echo",
        "width": 768,
        "height": 640,
        "minWidth": 768,
        "minHeight": 560,
        "resizable": true,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --autoplay-policy=no-user-gesture-required --disable-background-timer-throttling --disable-backgrounding-occluded-windows --disable-renderer-backgrounding"
      }
    ],
    "security": { "csp": null }
  },
  "mainBinaryName": "Echo",
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "windows": {
      "nsis": { "languages": ["SimpChinese"] }
    }
  }
}
